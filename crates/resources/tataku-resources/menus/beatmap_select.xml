    <!-- </row> -->

    <!-- the next row has the score list, gameplay preview, and beatmap list -->
    <row id="middle">
      <!-- score list -->
      <column id="score-list">
        <!-- score list -->
        <conditional id="scores_list" cond="score_list.loaded">
          <conditional cond="score_list.scores.is_empty">
            <text>No scores</text>

            <false>
              <list
                list = "score_list.scores"
                variable = "_score"
                scrollable = "true"
                style = "width: fill; height: fill; flex-direction: column;"
              >
                <button style="width: fill; height: auto; margin: 5px">
                  <action>
                    <game>
                      <viewScore><variable>_score.id</variable></viewScore>
                    </game>
                  </action>

                  <column style="width: fill; height: auto">
                    <!-- username and score  -->
                    <row style="width: fill;">
                      <text>
                          <variable>_score.score.username</variable>: <display>_score.score.score</display>
                      </text>
                    </row>

                    <!-- combo, acc, mods -->
                    <row style="width: fill;">
                      <text>
                          <display>_score.score.max_combo</display>x, <calc>display(_score.score.accuracy * 100.0)</calc>% <iter
                            variable = "_score.score.mods"
                            property = ".display_name"
                            join = ", "
                          />
                      </text>
                    </row>
                  </column>
                </button>

              </list>
            </false>
          </conditional>

          <false>
            <text>Loading...</text>
          </false>
        </conditional>
      </column>

      <!-- gameplay preview and map list -->
      <row style="width: 92%; height: fill; ">
        <gameplayPreview style="width: 40%; height: fill" />

        <!-- beatmap group list -->
        <list
          id = "group-list"
          list = "beatmaps.groups"
          variable = "_group"
          scrollable = "true"
        >
          <column id="group-item">
            <!-- set info -->
            <button active="_group.selected">
              <action>
                <map>
                  <selectGroup>
                    <variable>_group.id</variable>
                  </selectGroup>
                </map>
                <custom>scroll-to-selected</custom>
              </action>

              <text>
                <variable>_group.name</variable>
              </text>
            </button>

            <!-- map items -->
            <conditional cond="_group.selected">
              <list
                style = "width: fill; height: auto; margin: 2px; flex-direction: column;"
                list = "_group.maps"
                variable = "_map"
              >
                <column class="map-list">
                  <button
                    class = "map-item"
                    active = "beatmaps.current == _map"
                  >
                    <action button="left">
                      <conditional cond="beatmaps.current == _map">
                        <!-- if the map is selected -->
                        <!-- confirm it -->
                        <map> <confirm /> </map>

                        <!-- otherwise, set it as the selected map  -->
                        <false>
                          <map>
                            <selectMap>
                              <variable>_map</variable>
                            </selectMap>
                          </map>
                        </false>
                      </conditional>
                    </action>

                    <action button="right">
                      <map>
                        <selectMap> <variable>_map</variable> </selectMap>
                      </map>
                      <addDialog>beatmap_settings</addDialog>
                    </action>

                    <column class="map-item-inner">
                      <!-- title and stuff -->
                      <conditional cond="beatmaps.diffs[_map].diff > 0.0">
                        <text style="flex-shrink: 0.0">
                          <display>beatmaps.beatmaps[_map].playmode</display> - <variable>beatmaps.beatmaps[_map].version</variable> (diff: <display>beatmaps.diffs[_map].diff</display>)
                        </text>

                        <false>
                          <text>
                            <display>beatmaps.beatmaps[_map].playmode</display> - <variable>beatmaps.beatmaps[_map].version</variable>
                          </text>
                        </false>
                      </conditional>

                      <!-- diff info -->
                      <text class="diff-info">
                        <variable>beatmaps.diffs[_map].info</variable>
                      </text>
                    </column>
                  </button>
                </column>
              </list>
            </conditional>
          </column>
        </list>
      </row>
    </row>

    <!-- Bottom bar things -->
    <row id="bottom-bar">

      <!-- Back button -->
      <button>
        <action>
          <conditional cond="lobby.is_some">
            <setMenu>lobby_menu</setMenu>

            <false>
              <setMenu>main_menu</setMenu>
            </false>
          </conditional>
        </action>

        <text>Back</text>
      </button>

      <!-- Mods button -->
      <button>
        <action>
          <addDialog>mods_dialog</addDialog>
        </action>

        <text>Mods</text>
      </button>

      <button>
        <action>
          <!-- TODO: user profile popup -->
          <none/>
        </action>

        <column>
          <text>
            <variable>settings.username</variable>
          </text>
          <conditional cond="online.logged_in">
            <!-- TODO: add more things, like rank etc? -->
            <text>Online</text>


            <false>
              <text>Offline</text>
            </false>
          </conditional>
        </column>
      </button>

    </row>

  </column>
