<?xml version="1.0"?>
<?xml-model href="../xsd/menu.xsd"?>

<menu id = "fail_menu">
    <style> 
        .menu {
            width: auto; 
            height: auto; 
            align-content: center;
            
            image: "fail-background";
            image-source: skin;
            image-stretch: fit;
        }
    </style>

    <column class="menu">
        <!-- retry button -->
        <button>
            <action>
                <gameplay><retry/></gameplay>
            </action>

            <text>Retry</text>
        </button>

        <!-- quit button -->
        <button>
            <action>
                <setMenu>beatmap_select</setMenu>
                <gameplay><quit/></gameplay>
            </action>

            <text>Quit</text>
        </button>
    </column>
</menu>
