<?xml version="1.0"?>
<?xml-model href="../xsd/menu.xsd"?>

<menu id="pause_menu">
    <style> 
        .menu {
            width: auto; 
            height: auto; 
            align-content: center;
            
            image: "pause-overlay";
            image-source: skin;
            image-stretch: fit;
        }
    </style>

    <events>
        <keyPress key="Escape">
            <gameplay><resume/></gameplay>
        </keyPress>
    </events>

    <column class="menu">
        <!-- resume button -->
        <button>
            <action>
                <gameplay><resume/></gameplay>
            </action>

            <text>Resume</text>
        </button>

        <!-- retry button -->
        <button>
            <action>
                <gameplay><retry/></gameplay>
            </action>

            <text>Retry</text>
        </button>

        <!-- quit button -->
        <button>
            <action>
                <gameplay><quit/></gameplay>
                <setMenu>beatmap_select</setMenu>
            </action>

            <text>Quit</text>
        </button>
    </column>
</menu>
