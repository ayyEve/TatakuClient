<?xml version="1.0"?>

<xs:schema 
  targetNamespace="tataku/elements/text"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:elements="tataku/elements"
  xmlns:text="tataku/text"
>

<xs:import namespace="tataku/text" schemaLocation="../text.xsd"/>
<xs:import namespace="tataku/elements" schemaLocation="./elements.xsd"/>


<xs:complexType name="text-element">
  <xs:complexContent>
    <xs:extension base="elements:generic">
      <xs:sequence>
        <xs:group ref="text:text" minOccurs="1"/>
      </xs:sequence>
    </xs:extension>
  </xs:complexContent>
</xs:complexType>

</xs:schema>
