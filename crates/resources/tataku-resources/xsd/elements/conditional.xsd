<?xml version="1.0"?>

<xs:schema 
  targetNamespace="tataku/elements/conditional"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:elements="tataku/elements"
  xmlns:common="tataku/common"
  xmlns:conditional-element="tataku/elements/conditional"
>

<xs:import namespace="tataku/common" schemaLocation="../common.xsd"/>
<xs:import namespace="tataku/elements" schemaLocation="./elements.xsd"/>


<xs:complexType name="conditional-element">
  <xs:complexContent>
    <xs:extension base="elements:generic">
      <xs:sequence>
        <xs:choice>
          <xs:group ref="elements:element"/>
          <xs:element name="true">
            <xs:complexType>
              <xs:group ref="elements:element"/>
            </xs:complexType>
          </xs:element>
        </xs:choice>
        <xs:element name="false" minOccurs="0">
          <xs:complexType>
            <xs:group ref="elements:element"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="cond" type="common:condition" use="required"/>
    </xs:extension>
  </xs:complexContent>
</xs:complexType>

</xs:schema>
