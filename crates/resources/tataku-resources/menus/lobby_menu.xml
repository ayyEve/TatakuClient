<?xml version="1.0"?>
<?xml-model href="../xsd/menu.xsd"?>

<menu id="lobby_menu">
    <style>
        .preview {
            position: absolute;
            width: fill;
            height: fill;
        }

        .slot-icon {
            font: icon;
        }

        .slot-button {
            width: auto; 
            height: auto; 
            margin: 5px; 
            padding: 5px;
        }
    </style>

    <events>
        <!-- on song end, restart song at preview point -->
        <songEnd>
            <!-- set position to the preview point -->
            <song><position>0</position></song>
            <!-- play -->
            <song><play/></song>
        </songEnd>

        <keyPress key = "Escape">
            <conditional cond = "var.lobby.last_escape - now() > 2000">
                <setMenu>main_menu</setMenu>

                <false>
                    <setValue key="var.lobby.last_escape">
                        <calc>now()</calc>
                    </setValue>
                </false>
            </conditional>
        </keyPress>
    </events>


    <row style = "width: fill; height: fill;">
        <!-- slot list -->
        <column style="width: fill; height: auto; margin: 5px;">
            <list
                id = "slot_list"
                style = "width: auto; height: auto; flex-direction: column;"
                list = "lobby.player_slots"
                variable = "_slot"
                scrollable = "true"
            >
                <row>
                    <!-- slot icon -->
                    <button class = "slot-button">
                        <action>
                            <conditional cond = "lobby.is_host">
                                <!-- if we're host -->
                                <conditional cond = "_slot.filled">
                                    <!-- and the slot is filled -->
                                    <conditional cond = "!_slot.is_host">
                                        <!-- and the slot isnt us, kick -->
                                        <multiplayer>
                                            <slot>
                                                <variable>_slot.id</variable>
                                                <kick/>
                                            </slot>
                                        </multiplayer>
                                    </conditional>

                                    <false>
                                        <!-- if the slot isnt filled -->
                                        <conditional cond = "_slot.locked">
                                            <!-- and the slot is locked -->
                                            <!-- unlock it -->
                                            <multiplayer>
                                                <slot>
                                                    <variable>_slot.id</variable>
                                                    <unlock/>
                                                </slot>
                                            </multiplayer>

                                            <!-- lock it -->
                                            <false>
                                                <multiplayer>
                                                    <slot>
                                                        <variable>_slot.id</variable>
                                                        <lock/>
                                                    </slot>
                                                </multiplayer>
                                            </false>
                                        </conditional>
                                    </false>
                                </conditional>
                            </conditional>
                        </action>

                        <conditional cond = "_slot.is_host">
                            <!-- crown icon -->
                            <text class = "slot-icon" style = "font: icon">&#xF521;</text>

                            <false>
                                <conditional cond = "_slot.empty || _slot.filled">
                                    <!-- lock -->
                                    <text class = "slot-icon" style = "font: icon;">&#xF13E;</text>

                                    <false>
                                        <!-- unlock -->
                                        <text class = "slot-icon" style = "font: icon;">&#xF023;</text>
                                    </false>
                                </conditional>
                            </false>
                        </conditional>
                    </button>

                    <!-- slot text -->
                    <conditional cond = "_slot.filled">
                        <button>
                            <action>
                                <multiplayer>
                                    <slot>
                                        <variable>_slot.id</variable>
                                        <showProfile/>
                                    </slot>
                                </multiplayer>
                            </action>

                            <text>
                                <variable>_slot.user.username</variable> (<variable>_slot.user.status</variable>)
                            </text>
                        </button>

                        <false>
                            <button>
                                <action>
                                    <conditional cond="!_slot.locked">
                                        <multiplayer>
                                            <slot>
                                                <variable>_slot.id</variable>
                                                <move/>
                                            </slot>
                                        </multiplayer>
                                    </conditional>
                                </action>

                                <text>Empty</text>
                            </button>
                        </false>
                    </conditional>
                </row>
            </list>
        </column>

        <!-- beatmap info button and gameplay preview -->
        <column style = "width: auto; height: fill;">
            <!-- beatmap info button -->
            <!-- this is a mess but its also a complex button lol -->
            <button style="width: auto; height: auto;">
                <action>
                    <conditional cond="lobby.is_host">
                        <!-- if we're the host, always override the button with opening the beatmap select menu -->
                        <setMenu>beatmap_select</setMenu>

                        <false>
                            <!-- if we're not the host, and we don't have the beatmap -->
                            <conditional cond = "!lobby.we_have_beatmap">
                                <multiplayer>
                                    <!-- open a link to the beatmap -->
                                    <openMapLink/>
                                </multiplayer>
                            </conditional>
                        </false>
                    </conditional>
                </action>

                <conditional cond="lobby.is_host">
                    <conditional cond="lobby.we_have_beatmap">
                        <text>
                            <variable>beatmaps.beatmaps[beatmaps.current].artist</variable> - <variable>beatmaps.beatmaps[beatmaps.current].title</variable><!-- newline -->&#xA;<variable>beatmaps.beatmaps[beatmaps.current].version</variable> // <variable>beatmaps.beatmaps[beatmaps.current].creator</variable><!-- newline -->&#xA;Click here to change the beatmap
                        </text>

                        <false>
                            <conditional cond="lobby.map.is_some">
                                <text>
                                    <variable>lobby.info.current_beatmap.title</variable> (<variable>lobby.info.current_beatmap.mode</variable>)<!-- newline -->&#xA;Click here to change the beatmap
                                </text>

                                <false>
                                    <text>
                                        No beatmap<!-- newline -->&#xA;Click here to change the beatmap
                                    </text>
                                </false>
                            </conditional>
                        </false>
                    </conditional>

                    <false>
                        <!-- if not host -->
                        <conditional cond="lobby.we_have_beatmap">
                            <text>
                                <variable>beatmaps.beatmaps[beatmaps.current].artist</variable> - <variable>beatmaps.beatmaps[beatmaps.current].title</variable> var=""/><!-- newline -->&#xA;<variable>beatmaps.beatmaps[beatmaps.current].version</variable> // <variable>beatmaps.beatmaps[beatmaps.current].creator</variable>
                            </text>

                            <false>
                                <!-- if we dont have the beatmap -->
                                <conditional cond="lobby.map.is_some">
                                    <text>
                                        <variable>lobby.info.current_beatmap.title</variable> (<variable>lobby.info.current_beatmap.mode</variable>)
                                    </text>

                                    <false>
                                        <text>No beatmap</text>
                                    </false>
                                </conditional>
                            </false>
                        </conditional>
                    </false>
                </conditional>
            </button>

            <!-- leave lobby and ready/unready button -->
            <row style = "width: fill; height: auto; justify-content: space-around">
                <!-- leave lobby button -->
                <button style= "width: auto; height: auto;">
                    <action>
                        <multiplayer><leave/></multiplayer>
                    </action>

                    <text>Leave Lobby</text>
                </button>

                <!-- ready/unready button -->
                <button style = "width: auto">
                    <action>
                        <conditional cond = "lobby.we_have_beatmap">
                            <!-- if we have the map -->
                            <conditional cond = "lobby.our_user_state == 'ready'">
                                <!-- and we're ready -->
                                <conditional cond = "lobby.is_host">
                                    <!-- and we're host -->
                                    <!-- start match -->
                                    <multiplayer><startMatch/></multiplayer>

                                    <!-- otherwise, unready -->
                                    <false> <multiplayer><unready/></multiplayer> </false>
                                </conditional>

                                <false>
                                    <!-- ready up -->
                                    <multiplayer><ready/></multiplayer>
                                </false>
                            </conditional>
                            <!-- if we dont have the map, we dont want to have an action here -->
                        </conditional>
                    </action>

                    <conditional cond="lobby.we_have_beatmap &amp;&amp; lobby.our_user_state == 'ready'">
                        <conditional cond="lobby.is_host">
                            <text>Start</text>

                            <false>
                                <text>Un-Ready</text>
                            </false>
                        </conditional>

                        <false>
                            <!-- otherwise, show "ready" -->
                            <text>Ready</text>
                        </false>
                    </conditional>
                </button>
            </row>
        </column>

        <!-- preview -->
        <gameplayPreview class="preview"/>
    </row>
</menu>
