<?xml version="1.0"?>

<xs:schema 
  targetNamespace="tataku/actions/song"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:buildable="tataku/buildable"
>

<xs:import namespace="tataku/buildable" schemaLocation="../buildable.xsd"/>


<xs:group name="song-action">
  <xs:choice>
    <xs:element name="play"/>
    <xs:element name="pause"/>
    <xs:element name="toggle"/>
    <xs:element name="restart"/>
    <xs:element name="pushQueue"/>
    <xs:element name="popQueue"/>
    <xs:element name="seek" type="buildable:value"/>
    <xs:element name="position" type="buildable:value"/>
    <xs:element name="rate" type="buildable:value"/>
  </xs:choice>
</xs:group>

</xs:schema>
