<?xml version="1.0"?>
<?xml-model href="../xsd/dialog.xsd"?>

<dialog 
    id = "mods_dialog" 
    title = "Mods"
    allow_multiple = "false"
>
    <style>
        #group-list {
            width: fill;
        }
    </style>

    <events>
        <menuEnter>
            <setValue key="var.mods.speed">
                <calc>cast(global.mods.speed.0, 'f32') / 100</calc>
            </setValue>
        </menuEnter>
    </events>

    <column style = "width: fill; height: fill; blur: 2;">
        <text>Mods List</text>

        <!-- info -->
        <column>
            <!-- score -->
            <text>
                Score: <display precision="2">global.mods.score_multiplier</display>x
            </text>
            
            <row>
                <text>Speed: </text>
                <slider variable="var.mods.speed" min="0.4" max="2.0" step="0.1">
                    <onInput>
                        <setValue key="var.mods.speed"> <passedIn/> </setValue>
                        <mods> <setSpeed> <passedIn/> </setSpeed> </mods>
                    </onInput>
                </slider>
                <text> <display precision="2">var.mods.speed</display>x</text>
            </row>
        </column>

        <!-- list -->
        <list
            id = "group-list"
            list = "global.mod_groups"
            variable = "_group"
            scrollable = "true"
            style = "width: fill; height: auto; flex-direction: column;"
        >
            <column style = "width: fill">
                <text>
                    <variable>_group.name</variable>
                </text>

                <list
                    id = "mod-list"
                    list = "_group.mods"
                    variable = "_mod"
                    style = "flex-direction: column;"
                >
                    <row style = "justify-items: space-between">
                        <text>
                            <variable>_mod.display_name</variable> <variable>_mod.description</variable>
                        </text>

                        <checkbox
                            value = "_mod.enabled"
                            style = "width: 30%;"
                        >
                            <onClick>
                                <mods>
                                    <toggleMod>
                                        <variable>_mod.id</variable>
                                    </toggleMod>
                                </mods>
                            </onClick>
                        </checkbox>
                    </row>
                </list>
            </column>
        </list>

    </column>
</dialog>
