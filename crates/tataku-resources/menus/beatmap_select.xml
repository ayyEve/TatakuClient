<?xml version="1.0"?>
<?xml-model href="../xsd/menu.xsd"?>

<menu id="beatmap_select">
  <style>
    #score-list {
      width: 8%; 
      height: fill; 
      justify-content: space-between;
    }

    #group-list {
      width: fill; 
      height: fill; 
      flex-direction: column; 
      
      flex-shrink: 1; 
      flex-grow: 1; 
      flex-basis: 0;
    }

    .group-item {
      width: fill; 
      padding: 2px; 
      margin: 2px;
    }

    .map-list {
        width: fill;
        height: auto;
        margin: 2px;
        
        justify-content: space-around; 
        align-content: end; 
        flex-wrap: wrap; 
        flex-direction: column; 
    }
    .map-item {
        width: auto;
        height: auto;
        flex-shrink: 0.0;
        padding: 5px;
        margin: 2px;
    }
    .map-item-inner {
        width: fill; 
        height: fill; 
        padding: 5px; 
        margin: 2px;
    }

    .diff-info {
        font-size: 14px;
    }

    #top-bar {
      width: fill; 
      height: auto; 
      justify-content: space-between;
    }

    #middle {
      width: fill;
      height: 80%;
      max-height: fill;
    }

    #bottom-bar {
      width: fill; 
      height: auto;

      justify-items: space-between;
    }
  </style>

  <events>
    <!-- on entering menu, make sure song is playing, and is also at the proper rate -->
    <event>
      <menuEnter />
      <actions>
        <conditional cond="!song.playing">
          <true>
            <song>
              <play />
            </song>
          </true>
        </conditional>
        <song>
          <rate><variable var="global.mods.speed"/></rate>
        </song>

        <!-- also make sure the cursor is visible -->
        <cursor>
          <show />
        </cursor>

        <game>
          <refreshScores/>
        </game>
      </actions>
    </event>

    <!-- on song end, restart song at preview point -->
    <event>
      <songEnd />
      <actions>
        <!-- set position to the preview point -->
        <song>
          <position><variable var="beatmaps.current.map.preview"/></position>
        </song>
        <!-- play -->
        <song>
          <play />
        </song>
      </actions>
    </event>

    <!-- when a new map is added, select it -->
    <event>
      <mapAdded />
      <actions>
        <map>
          <selectMap><passedIn /></selectMap>
        </map>
      </actions>
    </event>

    <!-- make sure new songs are set with the correct rate -->
    <event>
      <songStart />
      <actions>
        <song>
          <rate><variable var="global.mods.speed"/></rate>
        </song>
      </actions>
    </event>

    <!-- key events -->


    <!-- select set -->
    <event>
      <keyPress key="Enter" />
      <actions>
        <map>
          <confirm />
        </map>
      </actions>
    </event>

    <!-- previous set -->
    <event>
      <keyPress key="Left" />
      <actions>
        <map>
          <previousSet />
        </map>
      </actions>
    </event>

    <!-- next set -->
    <event>
      <keyPress key="Right" />
      <actions>
        <map>
          <nextSet />
        </map>
      </actions>
    </event>

    <!-- previous map -->
    <event>
      <keyPress key="Up" />
      <actions>
        <map>
          <previousMap />
        </map>
      </actions>
    </event>

    <!-- next map -->
    <event>
      <keyPress key="Down" />
      <actions>
        <map>
          <nextMap />
        </map>
      </actions>
    </event>

    <!-- back to main menu -->
    <event>
      <keyPress key="Escape" />
      <actions>
        <conditional cond="lobby.is_some">
          <true>
            <setMenu id="lobby_menu" />
          </true>
          <false>
            <setMenu id="main_menu" />
          </false>
        </conditional>
      </actions>
    </event>

    <!-- open mods dialog -->
    <event>
      <keyPress key="M" ctrl="true" />
      <actions>
        <addDialog id="mods_dialog" />
      </actions>
    </event>

    <!-- nofail -->
    <event>
      <keyPress key="N" ctrl="true" />
      <actions>
        <mods>
          <toggleMod><value val="no_fail"/></toggleMod>
        </mods>
      </actions>
    </event>

    <!-- autoplay -->
    <event>
      <keyPress key="A" ctrl="true" />
      <actions>
        <mods>
          <toggleMod><value val="autoplay"/></toggleMod>
        </mods>
      </actions>
    </event>

    <!-- speed up -->
    <event>
      <keyPress key="Equals" ctrl="true" />
      <actions>
        <mods>
          <addSpeed>
            <value>0.1</value>
          </addSpeed>
        </mods>
        <!-- notify user of speed -->
        <game>
          <notification color="#FFFFFF">
            <duration><value>10000</value></duration>
            <text>
              <list>
                <text text="speed: "/>
                <variable var="mods.speed"/>
              </list>
            </text>
          </notification>
        </game>
      </actions>
    </event>

    <!-- speed down -->
    <event>
      <keyPress key="Minus" ctrl="true" />
      <actions>
        <mods>
          <addSpeed><value>-0.1</value></addSpeed>
        </mods>
        <!-- notify user of speed -->
        <game>
          <notification color="#FFFFFF">
            <duration><value>10000</value></duration>
            <text>
              <list>
                <text text="speed:"/>
                <variable var="mods.speed"/>
              </list>
            </text>
          </notification>
        </game>
      </actions>
    </event>
  </events>

  <element>
    <!-- the beatmap select menu is broken up into rows -->
    <column style="width: fill; height: fill;">
      <!-- the first row contains the dropdowns and search -->
      <row id="top-bar">
        <!-- score method -->
        <dropdown
          id = "score_method_dropdown"
          options_path = "enums.score_methods"
          selected_path = "settings.score_method"
          style = "width: 20%; font-size: 25px;"
        >
          <onSelect>
            <setValue key="settings.score_method">
              <passedIn />
            </setValue>
          </onSelect>
        </dropdown>

        <!-- playmode -->
        <dropdown
          id = "playmode_dropdown"
          options_path = "enums.playmodes"
          selected_path = "global.playmode"
          style = "width: 20%; font-size: 25px;"
          placeholder = "Play Mode"
        >
          <onSelect>
            <map>
              <setPlaymode>
                <passedIn />
              </setPlaymode>
            </map>
          </onSelect>
        </dropdown>

        <!-- sort by -->
        <dropdown
          id = "sort_by_dropdown"
          options_path = "enums.sort_by"
          selected_path = "settings.sort_by"
          style = "width: 20%; font-size: 25px;"
          placeholder = "Sort"
        >
          <onSelect>
            <setValue key="settings.sort_by">
              <passedIn />
            </setValue>
          </onSelect>
        </dropdown>

        <!-- Filter text -->
        <textInput
          style = "width: 20%; font-size: 20px;"
          variable = "beatmaps.filter_text"
        >
          <placeholder>
            <text text="Search"/>
          </placeholder>
          <onInput>
            <map>
              <refreshMaps />
            </map>
          </onInput>
        </textInput>

      </row>

      <!-- the next row has the score list, gameplay preview, and beatmap list -->
      <!-- FIXME: Something here is growing too big, pushing the bottom bar off-screen (and hiding the last item in the list) -->
      <row id="middle">
        <!-- score list -->
        <column id="score-list">
          <!-- score list -->
          <conditional id="scores_list" cond="score_list.loaded">
            <true>
              <conditional cond="score_list.scores.is_empty">
                <true>
                  <text>
                    <text text="No scores"/>
                  </text>
                </true>
                <false>
                  <list
                    list = "score_list.scores"
                    variable = "_score"
                    scrollable = "true"
                    style = "width: fill; height: fill; flex-direction: column;"
                  >
                    <button style="width: fill; height: auto; margin: 5px">
                      <action>
                        <game>
                          <viewScore><variable var="_score.id"/></viewScore>
                        </game>
                      </action>

                      <element>
                        <column style="width: fill; height: auto">
                          <!-- username and score  -->
                          <row style="width: fill;">
                            <text>
                              <list join=": ">
                                <variable var="_score.score.username"/>
                                <display var="_score.score.score"/>
                              </list>
                            </text>
                          </row>

                          <!-- combo, acc, mods -->
                          <row style="width: fill;">
                            <text>
                              <list join="">
                                <display var="_score.score.max_combo"/>
                                <text text="x, "/>
                                <calc calc="display(_score.score.accuracy * 100.0)"/>
                                <text text="% "/>
                                <textIter
                                  variable = "_score.score.mods"
                                  property = ".display_name"
                                  join = ", "
                                />
                              </list>
                            </text>
                          </row>
                        </column>

                      </element>
                    </button>

                  </list>
                </false>
              </conditional>
            </true>
            <false>
              <text>
                <text text="Loading..."/>
              </text>
            </false>
          </conditional>
        </column>

        <!-- gameplay preview and map list -->
        <row style="width: 92%; height: fill; ">
          <gameplayPreview style="width: 40%; height: fill" />
          
          <!-- beatmap group list -->
          <list
            id = "group-list"
            list = "beatmaps.groups"
            variable = "_group"
            scrollable = "true"
          >
            <column id="group-item">
              <!-- set info -->
              <button active="_group.selected">
                <action>
                  <map>
                    <selectGroup>
                      <variable var="_group.id"/>
                    </selectGroup>
                  </map>
                </action>
                <element>
                  <text>
                      <variable var="_group.name"/>
                  </text>
                </element>
              </button>

              <!-- map items -->
              <conditional cond="_group.selected">
                <list
                  style = "width: fill; height: auto; margin: 2px; flex-direction: column;"
                  list = "_group.maps"
                  variable = "_map"
                >
                  <column class="map-list">
                    <button
                      class = "map-item"
                      active = "beatmaps.current.map.beatmap_hash == _map.map.beatmap_hash"
                    >
                      <action>
                        <conditional
                          cond="beatmaps.current.map.beatmap_hash == _map.map.beatmap_hash">
                          <!-- if the map is selected -->
                          <true>
                            <!-- confirm it -->
                            <map> <confirm /> </map>
                          </true>
                          <!-- otherwise, set it as the selected map  -->
                          <false>
                            <map>
                              <selectMap>
                                <variable var="_map.map.beatmap_hash"/>
                              </selectMap>
                            </map>
                          </false>
                        </conditional>
                      </action>
                      <element>
                        <column class="map-item-inner">
                          <!-- title and stuff -->
                          <conditional cond="_map.diff_rating > 0.0">
                            <true>
                              <text style="flex-shrink: 0.0">
                                <list>
                                  <display var="_map.map.playmode"/>
                                  <text text=" - "/>
                                  <variable var="_map.map.version"/>
                                  <text text=" (diff: "/>
                                    <display var="_map.diff_rating"/>
                                  <text text=")"/>
                                </list>
                              </text>
                            </true>
                            <false>
                              <text>
                                <list join=" - ">
                                  <display var="_map.map.playmode"/>
                                  <variable var="_map.map.version"/>
                                </list>
                              </text>
                            </false>
                          </conditional>

                          <!-- diff info -->
                          <text class="diff-info">
                            <variable var="_map.diff_info"/>
                          </text>
                        </column>
                      </element>
                    </button>
                  </column>
                </list>
              </conditional>
            </column>
          </list>
        </row>
      </row>

      <!-- Bottom bar things -->
      <row id="bottom-bar">

        <!-- Back button -->
        <button>
          <action>
            <conditional cond="lobby.is_some">
              <true>
                <setMenu id="lobby_menu" />
              </true>
              <false>
                <setMenu id="main_menu" />
              </false>
            </conditional>
          </action>
          <element>
            <text>
              <text text="Back"/>
            </text>
          </element>
        </button>

        <!-- Mods button -->
        <button>
          <action>
            <addDialog id="mods_dialog"/>
          </action>
          <element>
            <text>
              <text text="Mods"/>
            </text>
          </element>
        </button>

        <button>
          <action>
            <!-- TODO: user profile popup -->
            <none/>
          </action>
          <element>
            <column>
              <text>
                <variable var="settings.username"/>
              </text>
              <conditional cond="online.logged_in">
                <true>
                  <!-- TODO: add more things, like rank etc? -->
                  <text>
                    <text text="Online"/>
                  </text>
                </true>
                <false>
                  <text>
                    <text text="Offline"/>
                  </text>
                </false>
              </conditional>
            </column>
          </element>
        </button>

      </row>

    </column>
  </element>
</menu>
