<?xml version="1.0"?>
<?xml-model href="../xsd/menu.xsd"?>
<menu id="menu_list">
    <style>
    </style>
    
    <!-- leave menu with escape -->
    <events>
        <keyPress key="Escape">
            <setMenu>main_menu</setMenu>
        </keyPress>
    </events>

    <column style = "width: fill; height: fill">
        <text>Menu List</text>

        <list
            style = "width: fill; height: auto"
            list = "global.menu_list"
            variable = "_menu"
            scrollable = "true"
        >
            <row style = "width: fill; height: auto; margin: 10px">
                <button style = "width: fill; height: auto; margin: 10px">
                    <action>
                        <setMenu><variable>_menu</variable></setMenu>
                    </action>

                    <text><variable>_menu</variable></text>
                </button>
            </row>
        </list>
    </column>
</menu>
