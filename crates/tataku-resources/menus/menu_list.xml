<?xml version="1.0"?>
<?xml-model href="../xsd/menu.xsd"?>
<menu id="menu_list">
    <style>
    </style>
    
    <!-- leave menu with escape -->
    <events>
        <event>
            <keyPress key="Escape"/>
            <actions>
                <setMenu id="main_menu"/>
            </actions>
        </event>
    </events>

    <element>
        <column style = "width: fill; height: fill">
            <text><text text="Menu List"/></text>
            <list
                style = "width: fill; height: auto"
                list = "global.menu_list"
                variable = "_menu"
                scrollable = "true"
            >
                <row style = "width: fill; height: auto; margin: 10px">
                    <button style = "width: fill; height: auto; margin: 10px">
                        <action>
                            <setMenu><variable var="_menu"/></setMenu>
                        </action>
                        <element>
                            <text><variable var="_menu"/></text>
                        </element>
                    </button>
                </row>
            </list>
        </column>
    </element>

</menu>