<?xml version="1.0"?>
<?xml-model href="../xsd/menu.xsd"?>
<menu id="lobby_select">
    <style>
    </style>

    <events>
        <!-- leave menu with escape -->
        <keyPress key="Escape">
            <setMenu>main_menu</setMenu>
        </keyPress>
    </events>

    <column style="width: fill; height: fill; align-content: space-between">
        <!-- list of lobbies -->
        <list
            id = "lobby_list"
            list = "online.lobbies"
            variable = "_lobby"
            scrollable = "true"
        >
            <button style = "width: fill; height: auto; padding: 5px">
                <action>
                    <multiplayer>
                        <joinLobby><variable>_lobby.id</variable></joinLobby>
                    </multiplayer>
                </action>

                <text>
                    <variable>_lobby.name</variable>
                </text>
            </button>
        </list>

        <!-- buttons -->
        <row style = "width: fill; height: auto;">
            <button>
                <action><addDialog>create_lobby</addDialog></action>

                <text>Create Lobby</text>
            </button>
        </row>
    </column>
</menu>
