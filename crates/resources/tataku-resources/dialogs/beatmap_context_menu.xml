<?xml version="1.0"?>
<?xml-model href="../xsd/dialog.xsd"?>

<dialog 
    id = "beatmap_context_menu" 
    title = "Beatmap Options"
>
    <row>
        <!-- copy hash -->
        <button>
            <action>
                <game>
                    <copyToClipboard>
                        <variable>beatmaps.current_beatmap.map.hash</variable>
                    </copyToClipboard>
                </game>
            </action>

            <text>Copy Hash</text>
        </button>

        <!-- Delete -->
        <button>
            <action>
                <map><deleteCurrent/></map>
            </action>

            <text>Delete</text>
        </button>


        <!-- open settings -->
        <button>
            <action>
                <addDialog>beatmap_settings</addDialog>
            </action>

            <text>Open Settings</text>
        </button>
    </row>
</dialog>
