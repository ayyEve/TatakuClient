<?xml version="1.0"?>
<?xml-model href="../xsd/dialog.xsd"?>

<dialog 
    id = "create_lobby" 
    title = "Create Lobby"
    draggable = "true"
>
    <events>
        <!-- on menu (dialog) enter, initialize our temp values/reset existing values -->
        <menuEnter>
            <setValue key="new_lobby.name"></setValue>
            <setValue key="new_lobby.password"></setValue>
            <setValue key="new_lobby.private">false</setValue>
        </menuEnter>
    </events>

    <column>
        <text>Create Lobby:</text>

        <!-- Name -->
        <textInput variable="new_lobby.name">
            <placeholder>Lobby Name</placeholder>

            <onInput>
                <setValue key="new_lobby.name"> <passedIn/> </setValue>
            </onInput>
        </textInput>

        <!-- Password -->
        <textInput
            variable="new_lobby.name"
            password="true"
        >
            <placeholder>Lobby Password</placeholder>

            <onInput>
                <setValue key="new_lobby.password"> <passedIn/> </setValue>
            </onInput>
        </textInput>

        <!-- Private -->
        <row>
            <text>Private</text>
            <checkbox value="new_lobby.private">
                <onClick>
                    <setValue key="new_lobby.private"> <passedIn/> </setValue>
                </onClick>
            </checkbox>
        </row>

        <row style="width: fill;">
            <!-- Done -->
            <button>
                <action>
                    <multiplayer>
                        <createLobby>
                            <name>
                                <variable>new_lobby.name</variable>
                            </name>
                            <password>
                                <variable>new_lobby.password</variable>
                            </password>
                            <private>
                                <variable>new_lobby.private</variable>
                            </private>
                        </createLobby>
                    </multiplayer>
                    <closeDialog/>
                </action>

                <text>Done</text>
            </button>

            <!-- Cancel -->
            <button>
                <action>
                    <closeDialog/>
                </action>

                <text>Cancel</text>
            </button>
        </row>
    </column>
</dialog>
