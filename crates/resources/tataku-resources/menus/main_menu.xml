<?xml version="1.0"?>
<?xml-model href="../xsd/menu.xsd"?>

<menu id = "main_menu">
    <style>
        .fa-button {
            padding: 5px;
            border-radius: 5px;
        }

        .fa-button text {
            font: icon;
        }

        #song-display {
            width: fill; 
            height: auto; 
            padding: 8px; 
            border-radius: 5px; 

            align-content: end; 
            background-color: #FFFFFF11;
        }
    </style>

    <events>
        <!-- when a new map is added, select it -->
        <mapAdded>
            <map><selectMap><passedIn/></selectMap></map>
        </mapAdded>

        <!-- play the next map once the song ends -->
        <songEnd>
            <map><next/></map>
        </songEnd>
        
        <!-- when a song starts playing, send a notification -->
        <songStart>
            <game>
                <notification color="teal" duration="10000">
                    Now playing: <variable>beatmaps.beatmaps[beatmaps.current].title</variable> by <variable>beatmaps.beatmaps[beatmaps.current].artist</variable>
                </notification>
            </game>
        </songStart>

        
        <!-- previous set -->
        <keyPress key="Left">
            <map> <previousSet/> </map>
        </keyPress>

        <!-- next set -->
        <keyPress key="Right">
            <map> <nextSet/> </map>
        </keyPress>
    </events>

    <!-- the current main menu is broken up into rows -->
    <column id="pain" style = "width: fill; height: fill">
        <!-- the first row contains the song display -->
        <row id = "song-display">
            <text style = "font-size: 30px; text-color: #FFFF;">
                <variable>beatmaps.beatmaps[beatmaps.current].artist</variable> - <variable>beatmaps.beatmaps[beatmaps.current].title</variable>
            </text>
        </row>

        <!-- the next row is the preview and menu buttons -->
        <row id = "main_menu_row2" style = "width: fill; height: fill;">
            <gameplayPreview
                visualization = "menu_visualization"
                blur="25.0"
                blur_type="gaussian"
                style = "width: 80%; height: fill;"
            />

            <animatable id = "animatable" style = "width: 20%; height: fill;">
                <!-- TODO: fix animations!! -->
                <!-- <triggers>
                    <trigger action="unhide"> <input/> </trigger>
                    <trigger action="hide"> <noInput duration = "5000" /> </trigger>
                </triggers>
                <actions>
                    <action id="hide">
                        <action duration = "1000.0" >
                            <scaleX start="0.0" end="1.0" />
                        </action>
                    </action>
                    <action id="unhide">
                        <action duration = "1000.0">
                            <scaleX start="1.0" end="0.0"/>
                        </action>
                    </action>
                </actions> -->

                <column
                    id = "main_menu_buttons_list"
                    style = "width: fill; height: fill;"
                >
                    <!-- Singleplayer -->
                    <button>
                        <action>
                            <setMenu>beatmap_select</setMenu>
                        </action>

                        <text>Play</text>
                    </button>

                    <!-- Multiplayer -->
                    <button>
                        <action>
                            <conditional cond="online.logged_in">
                                <multiplayer><start/></multiplayer>

                                <false>
                                    <game>
                                        <notification color="RED" duration="5000">
                                            You must be online to play multiplayer!
                                        </notification>
                                    </game>
                                </false>
                            </conditional>
                        </action>

                        <text>Multiplayer</text>
                    </button>

                    <!-- Online Content -->
                    <button>
                        <action>
                            <setMenu>online_content</setMenu>
                        </action>

                        <text>Online Content</text>
                    </button>

                    <!-- Settings -->
                    <button>
                        <action>
                            <addDialog>settings</addDialog>
                        </action>

                        <text>Settings</text>
                    </button>

                    <!-- Quit -->
                    <button>
                        <action>
                            <game><quit/></game>
                        </action>

                        <text>Quit</text>
                    </button>
                </column>
            </animatable>
        </row>

        <!-- the next row is the media controls -->
        <row id = "media-controls" style = "width: fill; height: auto;">
            <!-- an inner row so the buttons arent spread out over the whole width -->
            <row id = "song-controls" style = "width: 30%; height: fill; align-content: space-evenly;">
                <!-- previous song -->
                <button class = "fa-button">
                    <action> <map><previous/></map> </action>

                    <text>&#xF04A;</text>
                </button>

                <!-- seek backwards -->
                <button class="fa-button">
                    <action> <map><previous/></map> </action>
                    <action> <song><seek>-500.0</seek></song> </action>

                    <text>&#xF048;</text>
                </button>

                <!-- play/pause button -->
                <conditional cond="song.playing">
                    <!-- pause -->
                    <button class="fa-button">
                        <action> <song><pause/></song> </action>

                        <text>&#xF04C;</text>
                    </button>

                    <!-- play -->
                    <false>
                        <button class="fa-button">
                            <action> <song><play/></song> </action>

                            <text>&#xF04B;</text>
                        </button>
                    </false>
                </conditional>

                <!-- seek forwards -->
                <button class="fa-button">
                    <action> <map><next/></map> </action>
                    <action> <song><seek>500.0</seek></song> </action>

                    <text>&#xF051;</text>
                </button>

                <!-- next song -->
                <button class="fa-button">
                    <action> <map><next/></map> </action>

                    <text>&#xF04E;</text>
                </button>
            </row>
        </row>

    </column>
</menu>
