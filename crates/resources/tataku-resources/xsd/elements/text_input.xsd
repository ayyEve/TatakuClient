<?xml version="1.0"?>

<xs:schema 
  targetNamespace="tataku/elements/text-input"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:elements="tataku/elements"
  xmlns:actions="tataku/actions"
  xmlns:text="tataku/text"
  xmlns:buildable="tataku/buildable"
>

<xs:import namespace="tataku/text" schemaLocation="../text.xsd"/>
<xs:import namespace="tataku/elements" schemaLocation="./elements.xsd"/>
<xs:import namespace="tataku/buildable" schemaLocation="./buildable.xsd"/>
<xs:import namespace="tataku/actions" schemaLocation="../actions/actions.xsd"/>


<xs:complexType name="text-input-element">
  <xs:complexContent>
    <xs:extension base="elements:generic">
      <xs:all>
        <xs:element name="placeholder" minOccurs="0" type="buildable:value"/>

        <xs:element name="onInput" type="actions:action-list" minOccurs="0"/>
        <xs:element name="onSubmit" minOccurs="0"/>
      </xs:all>
      <xs:attribute name="variable" type="text:string" use="required" />
      <xs:attribute name="placeholder" type="text:string"/>
      <xs:attribute name="password" type="xs:boolean" default="false" />
    </xs:extension>
  </xs:complexContent>
</xs:complexType>

</xs:schema>
