<?xml version="1.0"?>
<?xml-model href="../xsd/menu.xsd"?>

<menu id="pause_menu">
    <style> 
        .menu {
            width: auto; 
            height: auto; 
            align-content: center;
            
            image: "pause-overlay";
            image-source: skin;
            image-stretch: fit;
        }
    </style>

    <events>
        <event>
            <keyPress key="Escape" />
            <actions>
                <gameplay>
                    <resume/>
                </gameplay>
            </actions>
        </event>
    </events>

    <element>
        <column class="menu">
            <!-- resume button -->
            <button>
                <action>
                    <gameplay><resume/></gameplay>
                </action>
                <element>
                    <text>
                        <text text="Resume"/>
                    </text>
                </element>
            </button>

            <!-- retry button -->
            <button>
                <action>    
                    <gameplay><retry/></gameplay>
                </action>
                <element>
                    <text>
                        <text text="Retry"/>
                    </text>
                </element>
            </button>

            <!-- quit button -->
            <button>
                <action>
                    <list>
                        <gameplay><quit/></gameplay>
                        <setMenu id="beatmap_select"/>
                    </list>
                </action>
                <element>
                    <text>
                        <text text="Quit"/>
                    </text>
                </element>
            </button>

        </column>
    </element>
</menu>
