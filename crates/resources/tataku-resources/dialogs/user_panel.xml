<?xml version="1.0"?>
<?xml-model href="../xsd/dialog.xsd"?>

<dialog 
    id = "user_panel" 
    title = "Users"
>
    <style>
        .user {
            width: 20%;
            margin: 5px;
            flex-grow: 1;
            flex-shrink: 1;
            flex-basis: 0;
        }

        #user-list {
            width: fill;
            align-items: space-around;
        }
    </style>

    <list
        id = "user-list"
        list = "online.users"
        variable = "_user"
    >
        <column class="user">
            <!-- username -->
            <text>
                <variable>_user.username</variable>
            </text>
            <!-- status -->
            <conditional cond="_user.status_text">
                <text>
                    <variable>_user.status_text</variable>
                </text>
            </conditional>
        </column>
    </list>
</dialog>
