<?xml version="1.0"?>
<?xml-model href="../xsd/dialog.xsd"?>

<dialog 
    id = "beatmap_context_menu" 
    title = "Beatmap Options"
>
    <row>

        <!-- Settings -->
        <button>
            <action>
                <addDialog>beatmap_settings</addDialog>
                <closeDialog />
            </action>

            <text>Settings</text>
        </button>

        <!-- Add to Collection -->
        <button>
            <action>
                <addDialog>add_to_collection</addDialog>
                <closeDialog />
            </action>

            <text>Add to Collection</text>
        </button>


        <!-- Copy Hash -->
        <button>
            <action>
                <game>
                    <copyToClipboard>
                        <variable>beatmaps.current_beatmap.map.hash</variable>
                    </copyToClipboard>
                </game>
                <closeDialog />
            </action>

            <text>Copy Hash</text>
        </button>

        <!-- Delete -->
        <button>
            <action>
                <map><deleteCurrent/></map>
                <closeDialog />
            </action>

            <text>Delete</text>
        </button>
    </row>
</dialog>
