<?xml version="1.0"?>
<?xml-model href="../xsd/menu.xsd"?>

<menu id="score_menu">
  <style>
    .score-details {
      height: fill;
    }

    .buttons {
      width: fill;
      justify-self: end;
    }

    .judgment {
      padding: 4px;
      margin: 2px;
      border-radius: 3px;
    }
    .judgment-text {
      text-color: var(_j.judgment.color);
    }
  </style>

  <events>
    <keyPress key="Escape">
      <conditional cond="lobby.is_some">
        <setMenu>lobby_menu</setMenu>

        <false>
          <setMenu>beatmap_select</setMenu>
        </false>
      </conditional>
    </keyPress>

    <!-- ensure temp variables have a value -->
    <menuEnter>
      <setValue key="var.score_menu.selected_user">
        <variable>online.user_id</variable>
      </setValue>

      <setValue key="var.score_menu.selected_stat">0.0</setValue>
    </menuEnter>
  </events>

  <!-- should we be lobby-oriented? -->
  <conditional cond = "lobby.is_some">
    <!-- multiplayer menu -->
    <column>
      <row>
        <!-- score details -->
        <column>
          <!-- score info -->
          <list
            list = "lobby.player_scores"
            variable = "_score"
          >
            <conditional cond = "_score.user_id == var.score_menu.selected_user">
              <!-- score details -->
              <column class = "score-details">
                <!-- score title -->
                <row style = "width: fill">
                  <!-- title [version] (playmode) (speedx) -->
                  <conditional cond="_score.speed != 0.0">
                    <text>
                      <variable>beatmaps.beatmaps[beatmaps.current].title</variable> [<variable>beatmaps.beatmaps[beatmaps.current].version</variable>] (<variable>global.playmode_display</variable>) (<variable>_score.speed</variable>x)
                    </text>

                    <false>
                      <text>
                        <variable>beatmaps.beatmaps[beatmaps.current].title</variable> [<variable>beatmaps.beatmaps[beatmaps.current].version</variable>] (<variable>global.playmode_actual_display</variable>)
                      </text>
                    </false>
                  </conditional>
                </row>

                <!-- score -->
                <row>
                  <text>
                    Score: <display>_score.score</display>
                  </text>
                </row>

                <!-- judgments -->
                <list
                  style = "flex-direction: column"
                  list = "_score.judgments"
                  variable = "_j"
                >
                  <row>
                    <text>
                      <variable>_j.judgment.name</variable>: <display>_j.count</display>
                    </text>
                  </row>
                </list>

                <!-- combo -->
                <row>
                  <text>
                    Combo: <display>_score.combo</display>x, <calc>display(_score.accuracy * 100.0)</calc>%
                  </text>
                </row>

                <!-- mods -->
                <row>
                  <text>
                    <variable>_score.mods.short_list</variable>
                  </text>
                </row>

              </column>
            </conditional>
          </list>


        </column>


        <!-- lobby players -->
        <list
          list="lobby.player_scores"
          variable="_score"
        >
          <button>
            <action>
              <setValue key="var.score_menu.selected_user">
                <variable>_score.user_id</variable>
              </setValue>
            </action>

            <row>
              <text>
                <variable>_score.username</variable> <display>_score.score</display> (<display>_score.combo</display>x)
              </text>
            </row>
          </button>
        </list>
      </row>

      <button>
        <action>
          <setMenu>lobby_menu</setMenu>
        </action>

        <text>Back</text>
      </button>
    </column>

    <!-- singleplayer menu -->
    <false>
      <column>

        <row>
          <!-- score details -->
          <column class = "score-details">
            <!-- score title -->
            <row style = "width: fill">
              <!-- title [version] (playmode) (speedx) -->
              <conditional cond="score.speed != 0.0">
                <text>
                  <variable>beatmaps.beatmaps[beatmaps.current].title</variable> [<variable>beatmaps.beatmaps[beatmaps.current].version</variable>] (<variable>global.playmode_display</variable>) (<variable>score.speed</variable>x)
                </text>

                <false>
                  <text>
                    <variable>beatmaps.beatmaps[beatmaps.current].title</variable> [<variable>beatmaps.beatmaps[beatmaps.current].version</variable>] (<variable>global.playmode_display</variable>)
                  </text>
                </false>
              </conditional>
            </row>

            <!-- score -->
            <row>
              <text>
                Score: <display>score.score</display>
              </text>
            </row>

            <!-- judgments -->
            <list
              style = "flex-direction: column"
              list = "score.judgments"
              variable = "_j"
            >
              <conditional cond = "_j.judgment.name != ''">
                <row class = "judgment">
                  <text class = "judgment-text">
                    <variable>_j.judgment.name</variable>: <display>_j.count</display>
                  </text>
                </row>
              </conditional>
            </list>

            <!-- combo -->
            <row>
              <text>
                Combo: <display>score.combo</display>x, <display>score.accuracy</display>%
              </text>
            </row>

            <!-- mods -->
            <row>
              <text>
                <variable>score.mods.short_list</variable>
              </text>
            </row>

            <!-- submit status -->

            <!-- are we submitting a score? -->
            <conditional cond="var.score_menu.submit_path != ''">
              <!-- score is submitting -->
              <conditional cond="ref('::(var.score_menu.submit_path).completed')">
                <column>
                  <!-- placing -->
                  <text>
                      Placing: <calc>ref('::(var.score_menu.submit_path).placing')</calc>
                  </text>
                  <!-- performance -->
                  <text>
                    Performance: <calc>display(ref('::(var.score_menu.submit_path).performance_rating'))</calc>
                  </text>
                </column>

                <!-- still uploading -->
                <false>
                  <text>Score Uploading..</text>
                </false>
              </conditional>
            </conditional>
          </column>

          <!-- FIXME: reimplement stats -->
          <!-- stats -->
          <!-- <column>

          </column> -->
        </row>

        <row class = "buttons">
          <conditional cond="var.score_menu.allow_retry">
            <button>
              <action> <map><play/></map> </action>

              <text>Retry</text>
            </button>
          </conditional>

          <button>
            <action> <setMenu>beatmap_select</setMenu> </action>

            <text>Back</text>
          </button>
        </row>
      </column>
    </false>
  </conditional>
</menu>
