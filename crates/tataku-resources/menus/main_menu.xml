<?xml version="1.0"?>
<?xml-model href="../xsd/menu.xsd"?>

<menu id = "main_menu">
    <style>
        .fa-button {
            padding: 5px;
            border-radius: 5px;
        }

        .fa-button text {
            font: icon;
        }

        #song-display {
            width: fill; 
            height: auto; 
            padding: 8px; 
            border-radius: 5px; 

            align-content: end; 
            background-color: #FFFFFF11;
        }
    </style>

    <events>
        <!-- when a new map is added, select it -->
        <event>
            <mapAdded/>
            <actions>
                <map><selectMap><passedIn/></selectMap></map>
            </actions>
        </event>

        <!-- play the next map once the song ends -->
        <event>
            <songEnd/>
            <actions>
                <map><next/></map>
            </actions>
        </event>
        
        <!-- when a song starts playing, send a notification -->
        <event>
            <songStart/>
            <actions>
                <game>
                    <notification>
                        <color>teal</color> 
                        <duration><value>10000</value></duration>
                        <text>
                            <list join=" ">
                                <text text="Now playing: "/>
                                <variable var="beatmaps.current.map.title"/>
                                <text text=" by "/>
                                <variable var="beatmaps.current.map.artist"/>
                            </list>
                        </text>
                    </notification>
                </game>
            </actions>
        </event>

        
        <!-- previous set -->
        <event>
            <keyPress key="Left"/>
            <actions> <map> <previousSet/> </map> </actions>
        </event>

        <!-- next set -->
        <event>
            <keyPress key="Right"/>
            <actions> <map> <nextSet/> </map> </actions>
        </event>

    </events>

    <!-- the current main menu is broken up into rows -->
    <element>
        <column style = "width: fill; height: fill">
            <!-- the first row contains the song display -->
            <row id = "song-display">
                <text style = "font-size: 30px; text-color: #FFFF;">
                    <list>
                        <variable var="beatmaps.current.map.artist"/>
                        <text text=" - "/>
                        <variable var="beatmaps.current.map.title"/>
                    </list>
                </text>
            </row> 

            <!-- the next row is the preview and menu buttons -->
            <row id = "main_menu_row2" style = "width: fill; height: fill;">
                <gameplayPreview 
                    visualization = "menu_visualization" 
                    blur="25.0" 
                    blur_type="gaussian" 
                    style = "width: 80%; height: fill;"
                />

                <animatable id = "animatable" style = "width: 20%; height: fill;">
                    <!-- TODO: fix animations!! -->
                    <!-- <triggers>
                        <trigger action="unhide"> <input/> </trigger>
                        <trigger action="hide"> <noInput duration = "5000" /> </trigger>
                    </triggers>
                    <actions>
                        <action id="hide">
                            <action duration = "1000.0" >
                                <scaleX start="0.0" end="1.0" />
                            </action>
                        </action>
                        <action id="unhide">
                            <action duration = "1000.0">
                                <scaleX start="1.0" end="0.0"/>
                            </action>
                        </action>
                    </actions> -->

                    <element>
                        <column 
                            id = "main_menu_buttons_list" 
                            style = "width: fill; height: fill;"
                        >
                            <!-- Singleplayer --> 
                            <button> 
                                <action>
                                    <setMenu id="beatmap_select"/>
                                </action> 
                                <element>
                                    <text><text text="Play"/></text>
                                </element>
                            </button>

                            <!-- Multiplayer --> 
                            <button> 
                                <action>
                                    <conditional cond="online.logged_in">
                                        <true>
                                            <multiplayer><start/></multiplayer> 
                                        </true>
                                        <false>
                                            <game>
                                                <notification color="RED">
                                                    <duration> 
                                                        <value>5000</value>
                                                    </duration>
                                                    <text>
                                                        <text text="You must be online to play multiplayer!"/>
                                                    </text>
                                                </notification>
                                            </game>
                                        </false>
                                    </conditional>
                                </action>
                                <element>
                                    <text>
                                        <text text="Multiplayer"/>
                                    </text>
                                </element>
                            </button>

                            <!-- Online Content --> 
                            <button> 
                                <action>
                                    <setMenu>
                                        <value>online_content</value>
                                    </setMenu>
                                </action>
                                <element>
                                    <text>
                                        <text text="Online Content"/>
                                    </text>
                                </element>
                            </button>

                            <!-- Settings --> 
                            <button> 
                                <action>
                                    <addDialog id="settings"/>
                                </action>
                                <element>
                                    <text><text text="Settings"/></text>
                                </element>
                            </button>

                            <!-- Quit --> 
                            <button> 
                                <action>
                                    <game><quit/></game>
                                </action>
                                <element>
                                    <text><text text="Quit"/></text>
                                </element>
                            </button>
                        </column>
                    </element>
                </animatable>
            </row>

            <!-- the next row is the media controls -->
            <row id = "media-controls" style = "width: fill; height: auto;">
                <!-- an inner row so the buttons arent spread out over the whole width -->
                <row id = "song-controls" style = "width: 30%; height: fill; align-content: space-evenly">
                    <!-- previous song -->
                    <button class = "fa-button">
                        <action> <map><previous/></map> </action>
                        <element>
                            <text><text text="&#xF04A;"/></text>
                        </element>
                    </button>

                    <!-- seek backwards -->
                    <button class = "fa-button">
                        <action> <song><seek><value>-500.0</value></seek></song> </action>
                        <element>
                            <text><text text="&#xF048;"/></text>
                        </element>
                    </button>

                    <!-- play/pause button -->
                    <conditional cond = "song.playing">
                        <!-- pause -->
                        <true>
                            <button class = "fa-button">
                                <action> <song><pause/></song> </action>
                                <element>
                                    <text><text text="&#xF04C;"/></text>
                                </element>
                            </button>
                        </true>

                        <!-- play -->
                        <false>
                            <button class="fa-button">
                                <action> <song><play/></song> </action>
                                <element>
                                    <text><text text="&#xF04B;"/></text>
                                </element>
                            </button>
                        </false>
                    </conditional>
    
                    
                    <!-- seek forwards -->
                    <button class="fa-button">
                        <action> <song><seek><value>500.0</value></seek></song> </action>
                        <element>
                            <text><text text="&#xF051;"/></text>
                        </element>
                    </button>

                    <!-- next song -->
                    <button class="fa-button">
                        <action> <map><next/></map> </action>
                        <element>
                            <text><text text="&#xF04E;"/></text>
                        </element>
                    </button>
                </row>
            </row>
            
        </column>
    </element>
</menu>
