<?xml version="1.0"?>
<?xml-model href="../xsd/menu.xsd"?>

<menu id = "loading_menu">
    <list
        list = "game.loading_statuses"
        variable = "_status"
        style = "flex-direction: column;"
    >
        <row>
            <conditional cond="_status.error.is_some">
                <text style = "text-color: red;">
                    <variable>_status.name</variable>: Error: <variable>_status.error</variable>
                </text>

                <false>
                    <conditional cond="_status.complete">
                        <text>Done</text>

                        <false>
                            <text style = "text-color: green;">
                                <variable>_status.items_complete</variable>/<variable>_status.item_count</variable>
                            </text>
                        </false>
                    </conditional>
                </false>
            </conditional>
        </row>
    </list>
</menu>
