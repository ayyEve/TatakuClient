<?xml version="1.0"?>
<xs:schema 
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:text="tataku/text"
    targetNamespace="tataku/text"
>


<xs:simpleType name="string">
    <xs:restriction base="xs:string">
        <xs:whiteSpace value="collapse"/>
    </xs:restriction>
</xs:simpleType>

<xs:simpleType name="variable-path">
    <xs:restriction base="text:string"> 
        <!-- <xs:pattern value=""></xs:pattern> -->
    </xs:restriction>
</xs:simpleType>


<xs:simpleType name="condition">
  <xs:restriction base="text:string">
    <xs:minLength value="1"/>
  </xs:restriction>
</xs:simpleType>


</xs:schema>
