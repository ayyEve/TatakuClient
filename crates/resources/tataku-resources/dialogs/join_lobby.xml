<?xml version="1.0"?>
<?xml-model href="../xsd/dialog.xsd"?>

<dialog 
    id = "join_lobby" 
    title = "Join Lobby"
    draggable = "true"
>
    <events>
        <!-- on menu enter, initialize our temp values/reset existing values -->
        <menuEnter>
            <setValue key="temp.lobby_password"></setValue>
        </menuEnter>
    </events>

    <column>
        <text>Join Lobby:</text>

        <!-- Password -->
        <textInput
            variable = "temp.lobby_password"
            password = "true"
        >
            <placeholder>Lobby Password</placeholder>

            <onInput>
                <setValue key="temp.lobby_password"> <passedIn/> </setValue>
            </onInput>
        </textInput>

        <row style="width: fill;">
            <!-- Done/Join -->
            <button>
                <action>
                    <multiplayer>
                        <joinLobby>
                            <variable>var.lobby_id</variable>
                        </joinLobby>
                    </multiplayer>
                    <closeDialog/>
                </action>

                <text>Join</text>
            </button>

            <!-- Cancel -->
            <button>
                <action>
                    <closeDialog/>
                </action>

                <text>Cancel</text>
            </button>
        </row>
    </column>
</dialog>
