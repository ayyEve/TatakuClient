<?xml version="1.0"?>

<xs:schema 
  targetNamespace="tataku/elements/list"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:list="tataku/elements/list"
  xmlns:elements="tataku/elements"
  xmlns:text="tataku/text"
>

<xs:import namespace="tataku/text" schemaLocation="../text.xsd"/>
<xs:import namespace="tataku/elements" schemaLocation="./elements.xsd"/>


<xs:complexType name="list-element">
  <xs:complexContent>
    <xs:extension base="elements:generic">
      <xs:sequence>
        <xs:group ref="elements:element" minOccurs="1" maxOccurs="1"/>
      </xs:sequence>

      <xs:attribute name="list" type="text:string" use="required"/>
      <xs:attribute name="variable" type="text:string" use="required"/>
      <xs:attribute name="scroll" type="list:scroll-type" default="none"/>
    </xs:extension>
  </xs:complexContent>
</xs:complexType>


<xs:simpleType name="scroll-type">
    <xs:restriction base="text:string">
      <xs:enumeration value="none"/>
      <xs:enumeration value="vertical"/>
      <xs:enumeration value="horizontal"/>
      <xs:enumeration value="both"/>
    </xs:restriction>
</xs:simpleType>

</xs:schema>
