<?xml version="1.0"?>
<?xml-model href="../xsd/menu.xsd"?>

<menu id="beatmap_select">
  <style>
    #score-list {
      width: 8%; 
      height: fill; 
      justify-content: space-between;
    }

    #group-list {
      width: fill; 
      height: fill; 
      flex-direction: column; 
      
      flex-shrink: 1; 
      flex-grow: 1; 
      flex-basis: 0;
    }

    .group-item {
      width: fill; 
      padding: 2px; 
      margin: 2px;
    }

    .map-list {
        width: fill;
        height: auto;
        margin: 2px;
        
        justify-content: space-around; 
        align-content: end; 
        flex-wrap: wrap; 
        flex-direction: column; 
    }
    .map-item {
        width: auto;
        height: auto;
        flex-shrink: 0.0;
        padding: 5px;
        margin: 2px;
    }
    .map-item-inner {
        width: fill; 
        height: fill; 
        padding: 5px; 
        margin: 2px;
    }

    .diff-info {
        font-size: 14px;
    }

    #top-bar {
      width: fill; 
      height: auto; 
      justify-content: space-between;
    }

    #middle {
      width: fill;
      height: 80%;
      max-height: fill;
    }

    #bottom-bar {
      width: fill; 
      height: auto;

      justify-items: space-between;
    }
  </style>

  <events>
    <!-- on entering menu, make sure song is playing, and is also at the proper rate -->
    <menuEnter>
      <!-- <conditional cond="!song.playing">
        <song><play /></song>
      </conditional> -->
      <song>
        <rate><variable>global.mods.speed</variable></rate>
      </song>

      <!-- also make sure the cursor is visible -->
      <cursor><show /></cursor>

      <!-- and refresh the score list -->
      <game><refreshScores/></game>

      <!-- scroll to selected group and item -->
      <custom>scroll-to-selected</custom>
    </menuEnter>

    <!-- on song end, restart song at preview point -->
    <songEnd>
      <!-- set position to the preview point -->
      <song>
        <position><variable>beatmaps.beatmaps[beatmaps.current].preview</variable></position>
      </song>

      <song><play /></song>
    </songEnd>

    <!-- when a new map is added, select it -->
    <mapAdded>
      <map>
        <selectMap><passedIn /></selectMap>
      </map>
    </mapAdded>

    <!-- make sure new songs are set with the correct rate -->
    <songStart>
      <song>
        <rate><variable>global.mods.speed</variable></rate>
      </song>
    </songStart>

    <!-- <event>
      <custom>scroll-to-selected</custom>
      <actions>
        <delayed delay="100">
          <ui>
            <operate>
              <target>
                <id>group-list</id>
              </target>
              <operation>
                <scroll>
                  <scrollTo>
                    <active include_children="true" />
                  </scrollTo>
                </scroll>
              </operation>
            </operate>
          </ui>
        </delayed>
      </actions>
    </event> -->


    <!-- key events -->

    <!-- select set -->
    <keyPress key="Enter">
      <map><confirm /></map>
    </keyPress>

    <!-- previous set -->
    <keyPress key="Left">
      <map><previousSet /></map>
    </keyPress>

    <!-- next set -->
    <keyPress key="Right">
      <map><nextSet /></map>
    </keyPress>

    <!-- previous map -->
    <keyPress key="Up">
      <map><previousMap /></map>
    </keyPress>

    <!-- next map -->
    <keyPress key="Down">
      <map><nextMap /></map>
    </keyPress>

    <!-- back to main menu -->
    <keyPress key="Escape">
      <conditional cond="lobby.is_some">
        <setMenu>lobby_menu</setMenu>

        <false>
          <setMenu>main_menu</setMenu>
        </false>
      </conditional>
    </keyPress>

    <!-- open mods dialog -->
    <keyPress key="M" ctrl="true">
      <addDialog>mods_dialog</addDialog>
    </keyPress>

    <!-- nofail -->
    <keyPress key="N" ctrl="true">
      <mods>
        <toggleMod>no_fail</toggleMod>
      </mods>
    </keyPress>

    <!-- autoplay -->
    <keyPress key="A" ctrl="true">
      <mods>
        <toggleMod>autoplay</toggleMod>
      </mods>
    </keyPress>

    <!-- speed up -->
    <keyPress key="Equals" ctrl="true">
      <mods>
        <addSpeed>0.1</addSpeed>
      </mods>
      <!-- notify user of speed -->
      <delayed delay="1">
        <game>
          <notification color="#FFFFFF" duration="10000">
            Speed: <display precision="2">global.mods.speed</display>
          </notification>
        </game>
      </delayed>
    </keyPress>

    <!-- speed down -->
    <keyPress key="Minus" ctrl="true">
      <mods>
        <addSpeed>-0.1</addSpeed>
      </mods>
      <!-- notify user of speed -->
      <delayed delay="1">
        <game>
          <notification color="#FFFFFF" duration="10000">
            Speed: <display precision="2">global.mods.speed</display>
          </notification>
        </game>
      </delayed>
    </keyPress>
  </events>

  <!-- the beatmap select menu is broken up into rows -->
