<?xml version="1.0"?>

<xs:schema 
  targetNamespace="tataku/elements/text"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:elements="tataku/elements"
  xmlns:buildable="tataku/buildable"
>

<xs:import namespace="tataku/buildable" schemaLocation="../buildable.xsd"/>
<xs:import namespace="tataku/elements" schemaLocation="./elements.xsd"/>


<xs:complexType name="text-element" mixed="true">
  <xs:complexContent>
    <xs:extension base="elements:generic">
      <xs:sequence>
        <xs:group ref="buildable:text" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:extension>
  </xs:complexContent>
</xs:complexType>

</xs:schema>
