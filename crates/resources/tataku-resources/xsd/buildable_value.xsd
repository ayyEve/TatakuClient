<?xml version="1.0"?>

<xs:schema 
  targetNamespace="tataku/buildable-value"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:buildable-value="tataku/buildable-value"
  xmlns:text="tataku/text"
>

<xs:import namespace="tataku/text" schemaLocation="text.xsd"/>

<xs:complexType name="buildableValue" mixed="true">
    <xs:group ref="buildable-value:buildableValue-wrapped" minOccurs="0"/>
</xs:complexType>

<xs:group name="buildableValue-wrapped">
    <xs:choice>
        <xs:element name="none" />
        <xs:element name="variable" type="text:string"/>
        <xs:element name="passedIn" />
        <xs:element name="calc" type="text:string"/>
    </xs:choice>
</xs:group>

</xs:schema>
