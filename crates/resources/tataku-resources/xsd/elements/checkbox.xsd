<?xml version="1.0"?>

<xs:schema 
  targetNamespace="tataku/elements/checkbox"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:elements="tataku/elements"
  xmlns:actions="tataku/actions"
  xmlns:text="tataku/text"
>

<xs:import namespace="tataku/text" schemaLocation="../text.xsd"/>
<xs:import namespace="tataku/elements" schemaLocation="./elements.xsd"/>
<xs:import namespace="tataku/actions" schemaLocation="../actions/actions.xsd"/>


<xs:complexType name="checkbox-element">
  <xs:complexContent>
    <xs:extension base="elements:generic">
      <xs:all>
        <xs:element name="text" minOccurs="0">
          <xs:complexType>
            <xs:group ref="text:text"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="value" minOccurs="0" type="xs:string"/>

        <xs:element name="onClick" minOccurs="0">
          <xs:complexType>
            <xs:group ref="actions:action-type"/>
          </xs:complexType>
        </xs:element>

      </xs:all>
      <xs:attribute name="text" type="xs:string"/>
      <xs:attribute name="value" type="xs:string"/>
    </xs:extension>
  </xs:complexContent>
</xs:complexType>

</xs:schema>
