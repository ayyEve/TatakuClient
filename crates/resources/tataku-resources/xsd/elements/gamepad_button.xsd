<?xml version="1.0"?>

<xs:schema 
  targetNamespace="tataku/elements/gamepad-button"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:elements="tataku/elements"
  xmlns:actions="tataku/actions"
  xmlns:text="tataku/text"
>

<xs:import namespace="tataku/text" schemaLocation="../text.xsd"/>
<xs:import namespace="tataku/elements" schemaLocation="./elements.xsd"/>
<xs:import namespace="tataku/actions" schemaLocation="../actions/actions.xsd"/>


<xs:complexType name="gamepad-button-element">
  <xs:complexContent>
    <xs:extension base="elements:generic">
      <xs:all>
        <xs:element name="onInput" minOccurs="0">
          <xs:complexType>
            <xs:group ref="actions:action" />
          </xs:complexType>
        </xs:element>
      </xs:all>
      <xs:attribute name="variable" type="text:string" use="required" />
      <xs:attribute name="optional" type="xs:boolean" default="false" />
    </xs:extension>
  </xs:complexContent>
</xs:complexType>


</xs:schema>
