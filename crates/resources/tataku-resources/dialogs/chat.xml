<?xml version="1.0"?>
<?xml-model href="../xsd/dialog.xsd"?>

<dialog 
    id = "chat_dialog" 
    title = "Chat"
>
    <events>
        <menuEnter>
            <conditional cond="!var.current_chat_channel">
                <setValue key="var.current_chat_channel">#system</setValue>
            </conditional>
        </menuEnter>
    </events>

    <column>
        <row style="width: 100%, height: 30%; align-self: end">
            <!-- channel list-->
            <list
                style = "flex-direction: column"
                list = "online.chat_messages"
                variable = "_channel"
            >
                <text>
                    <variable>_channel.name</variable>
                </text>
            </list>

            <!-- message list and input text-->
            <column>
                <!-- TODO: please add the ability to join text and variables to create a path, this is pain -->
                <list 
                    list = "online.chat_messages" 
                    variable = "_channel"
                >
                    <conditional cond="_channel.name == var.current_chat_channel">
                        <list
                            style = "flex-direction: column"
                            list = "_channel.messages"
                            variable = "_message"
                        >
                            <text>
                                <variable>_message.formatted</variable>
                            </text>
                        </list>
                    </conditional>
                </list>

                <textInput variable="var.chat_input">
                    <onSubmit>
                        <chat>
                            <sendMessage>
                                <channel>
                                    <variable>_channel.name</variable>
                                </channel>

                                <variable>var.chat_input</variable>
                            </sendMessage>
                        </chat>

                        <setValue key="var.chat_input"></setValue>
                    </onSubmit>
                </textInput>
            </column>
        </row>
    </column>
</dialog>
